{
  "cli": {
    "version": ">= 3.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false,
        "autoIncrement": true
      }
    },
    "production": {
      "ios": {
        "autoIncrement": true,
        "bundleIdentifier": "com.joshu.kerykos"
      },
      "android": {
        "autoIncrement": true,
        "applicationId": "com.joshu.kerykos"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        // Placeholder values removed — fill in real values before running
        // `eas submit --platform ios`, or let EAS prompt you interactively.
        // See https://docs.expo.dev/submit/eas-json/
        // "appleId": "your-apple-id@example.com",
        // "ascAppId": "1234567890"
      },
      "android": {
        // Path to the Google Service Account JSON key (gitignored — never
        // commit real credentials). Set before `eas submit --platform android`.
        // "serviceAccountKeyPath": "./google-service-account.json"
      }
    }
  }
}
